# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
# Generate secret với lệnh: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl

# Google OAuth (for user login)
# Tạo tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Google Sheets API
# Tạo Service Account tại: https://console.cloud.google.com/iam-admin/serviceaccounts
# Download JSON key file và lấy các giá trị sau:
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"

# ID của Google Sheets (lấy từ URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit)
GOOGLE_SHEET_ID=your-google-sheet-id

# VietQR Payment Configuration
CLINIC_BANK_BIN=970415
CLINIC_ACCOUNT_NUMBER=1234567890123456
CLINIC_ACCOUNT_NAME=PHONG KHAM TONG GIA DUONG
CLINIC_NAME_DISPLAY=Phòng Khám Tống Gia Đường
CLINIC_NAME_SANITIZED=PHONG KHAM TONG GIA DUONG

# Optional: VietQR API (for enhanced features)
VIETQR_CLIENT_ID=your-vietqr-client-id
VIETQR_API_KEY=your-vietqr-api-key

# Banking Information for Display
CLINIC_BANK_NAME=VietinBank
CLINIC_BANK_BRANCH=Chi nhánh Tống Gia Đường